GOOGLE_SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=google-service-account.json
PORT=3000
HOST=127.0.0.1
MAX_UPLOAD_FILES=20
MAX_UPLOAD_BYTES_PER_FILE=52428800
PACKING_STORAGE_WARNING_BYTES=10737418240
MINIMUM_FREE_DISK_BYTES=5368709120
OPERATION_RECOVERY_MINIMUM_MINUTES=15
# Keep false until the verified warehouse starting count is complete.
INVENTORY_WRITES_ENABLED=false
# Current rollout tracks shipping boxes only. Use "all" only after product counts are ready.
INVENTORY_TRACKING_SCOPE=boxes

# Gmail low-stock alerts. Use a Google app password, never the normal account password.
LOW_STOCK_EMAIL_ENABLED=false
LOW_STOCK_EMAIL_USER=
LOW_STOCK_EMAIL_APP_PASSWORD=
LOW_STOCK_EMAIL_RECIPIENTS=

# Optional Supabase centralization. Leave every switch false until the migration
# SQL has been applied in a separate Supabase test project and check:supabase passes.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret. Never place this in public HTML or browser JavaScript.
SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_MIRROR_ENABLED=false
SUPABASE_STORAGE_MIRROR_ENABLED=false
SUPABASE_AUTH_ENABLED=false
SUPABASE_PACKING_BUCKET=packing-files
